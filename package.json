{
  "name": "costo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/db.ts",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f"
  },
  "dependencies": {
